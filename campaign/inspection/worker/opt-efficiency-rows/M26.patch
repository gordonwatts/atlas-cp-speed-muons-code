-@dataclass(frozen=True)
-class LinkRows:
+EFFICIENCY_LANES = ("random_run_number", "pt", "eta", "phi", "charge", "muon_type", "gate")
+
+
+class EfficiencyRows:
+    """Keep selected input rows in source order and one real skipped row at the end."""
+
+    def __init__(self, random_run_number, pt, eta, phi, charge, muon_type, gate):
+        self.size = gate.size
+        selected = gate == 1
+        self.selected_indices = np.flatnonzero(selected)
+        self.selected_size = self.selected_indices.size
+        lanes = (random_run_number, pt, eta, phi, charge, muon_type, gate)
+
+        zero = gate == 0
+        # Keep the original ordered calls for an invalid gate so the native
+        # state-membership and gate errors retain their original precedence.
+        self.compacted = self.selected_size < self.size and np.all(selected | zero)
+        if self.compacted:
+            indices = np.empty(self.selected_size + 1, dtype=np.intp)
+            indices[:-1] = self.selected_indices
+            indices[-1] = np.argmax(zero)
+            lanes = tuple(values[indices] for values in lanes)
+        self.lanes = lanes
+        self.gate = lanes[-1]
+        self.selected_pt = self.selected_values(lanes[1])
+
+    def selected_values(self, values):
+        if not self.compacted and self.selected_size < self.size:
+            return values[self.selected_indices]
+        return values[:self.selected_size]
+
+    def expand(self, values):
+        """Restore original object order using the correction's skipped result."""
+        if not self.compacted:
+            return values
+        dense = np.empty((self.size, *values.shape[1:]), dtype=values.dtype)
+        dense[:] = values[-1]
+        dense[self.selected_indices] = values[:-1]
+        return dense
+
+
+@dataclass(frozen=True)
+class LinkRows:
     key: np.ndarray
     index: np.ndarray
     valid: np.ndarray
