+    def primary_track_inputs(self, primary, momentum):
+        """Pack the selected primary role from existing momentum lanes where available."""
+        def perigee(role, field):
+            if field != "vz" and role in MOMENTUM_ROLES:
+                return momentum[f"{role}_{field}"]
+            return self.track(role, field)
+
+        diagonal = {}
+        for code, role in enumerate(SELECTION_ROLES, 1):
+            if not np.any(primary == code):
+                continue
+            if role in MOMENTUM_ROLES:
+                diagonal[role] = momentum[f"{role}_cov_diag_size"], momentum[f"{role}_cov_diag_0"]
+            else:
+                sizes, values = self.covariance(role, COV_DIAG, 5)
+                diagonal[role] = sizes, values[:, 0]
+
+        return {
+            **{f"primary_{field}": self.choose_track(
+                primary, lambda role: perigee(role, field), np.float64, 0,
+            ) for field in ("d0", "phi", "z0", "vz")},
+            "primary_cov_diag_size": self.choose_track(primary, lambda role: diagonal[role][0], np.int64, -1),
+            "primary_var_d0": self.choose_track(primary, lambda role: diagonal[role][1], np.float64, 0),
+        }
+
     def jagged(self, values, dtype):
         return ak.unflatten(np.asarray(values, dtype=dtype), self.counts)
