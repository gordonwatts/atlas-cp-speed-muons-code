+std::size_t Histogram::cell_index(double eta_coordinate, double phi_coordinate) const {
+#ifdef ATLAS_MUON_M04_STATS
+    ++(eta.edges.empty() ? bin_counts.eta_uniform : bin_counts.eta_variable);
+    ++(phi.edges.empty() ? bin_counts.phi_uniform : bin_counts.phi_variable);
+#endif
+    const int x = eta.coordinate_bin(eta_coordinate);
+    const int y = phi.coordinate_bin(phi_coordinate);
+    return root_compat::th2_global_bin(x, y, eta.bins, phi.bins);
+}
+
+double Histogram::lookup(double track_eta, double track_phi) const {
+    return content.at(cell_index(track_eta, track_phi));
+}
+
+BinLookup::BinLookup(double eta, double phi) : eta_(eta), phi_(phi) {
+    indices_.fill(empty_bin);
+}
+
+double BinLookup::value(const Histogram& histogram) {
+#ifdef ATLAS_MUON_M04_STATS
+    ++bin_counts.map_reads;
+#endif
+    if (histogram.layout_slot >= bin_cache_slots) {
+#ifdef ATLAS_MUON_M04_STATS
+        ++bin_counts.fallback_bins;
+#endif
+        return histogram.lookup(eta_, phi_);
+    }
+
+    auto& index = indices_[histogram.layout_slot];
+    if (index == empty_bin) {
+#ifdef ATLAS_MUON_M04_STATS
+        ++bin_counts.first_bins;
+#endif
+        index = histogram.cell_index(eta_, phi_);
+    }
+#ifdef ATLAS_MUON_M04_STATS
+    else {
+        ++bin_counts.reused_bins;
+    }
+#endif
+    return histogram.content.at(index);
+}
+
+void PeriodMaps::assign_layout_slots() {
+    // Representatives are used only while assigning slots within this period.
+    std::array<const Histogram*, bin_cache_slots> representatives{};
+    std::size_t used = 0;
+    const auto assign = [&](Histogram& histogram) {
+        histogram.layout_slot = bin_cache_slots;
+        for (std::size_t slot = 0; slot < used; ++slot) {
+            const auto& first = *representatives[slot];
+            if (same_axis(histogram.eta, first.eta) && same_axis(histogram.phi, first.phi)) {
+                histogram.layout_slot = slot;
+                return;
+            }
+        }
+        if (used < representatives.size()) {
+            histogram.layout_slot = used;
+            representatives[used++] = &histogram;
+        }
+    };
+
+    for (auto& detector : scale) {
+        for (auto& histogram : detector) assign(histogram);
+    }
+    for (auto& histogram : expected) assign(histogram);
+    for (auto& detector : sagitta) {
+        for (auto& histogram : detector) {
+            if (histogram) assign(*histogram);
+        }
+    }
+}
+
+double PeriodMaps::scale_value(Detector detector, ScaleParameter parameter, ScaleVariant variant, BinLookup& bins) const {
+    return bins.value(scale[detector][parameter * scale_variant_count + variant]);
+}
 
